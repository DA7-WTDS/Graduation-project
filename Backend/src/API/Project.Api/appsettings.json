{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "",
    "Redis": "localhost:6379"
  },
  "Authentication": {
    "Authority": "http://localhost:5000/",
    "Audience": "Project.Api",
    "Key": "",
    "ExpiresInMinutes": 60,
    "RequireHttpsMetadata": false,
    "TokenValidationParameters": {
      "ValidateIssuer": true,
      "ValidateAudience": true,
      "ValidateLifetime": true,
      "ValidateIssuerSigningKey": true
    }
  },
  "Email": {
    "From": "test@example.com",
    "Host": "localhost",
    "Port": 25
  },
  "Notifications": {
    "Inbox": {
      "IntervalInSeconds": 15,
      "BatchSize": 20
    }
  },
  "Users": {
    "Outbox": {
      "IntervalInSeconds": 15,
      "BatchSize": 20
    },
    "Inbox": {
      "IntervalInSeconds": 15,
      "BatchSize": 20
    }
  },
  "Portfolio": {
    "Outbox": {
      "IntervalInSeconds": 15,
      "BatchSize": 20
    },
    "Inbox": {
      "IntervalInSeconds": 15,
      "BatchSize": 20
    },
    "Instruments": {
      "PipelineBaseUrl": "http://localhost:8000",
      "TimeoutSeconds": 300,
      "Market": "us",
      "CronSchedule": "0 0 3 ? * *"
    },
    "Valuation": {
      "Market": "us",
      "CronSchedule": "0 30 3 ? * *",
      "DriftThreshold": 0.10
    },
    "Digest": {
      "CronSchedule": "0 0 7 ? * *"
    }
  },

  "Recommendations": {
    "Outbox": {
      "IntervalInSeconds": 15,
      "BatchSize": 20
    },
    "Inbox": {
      "IntervalInSeconds": 15,
      "BatchSize": 20
    },
    "Ingest": {
      "ApiKey": ""
    },
    "Llm": {
      "BaseUrl": "https://generativelanguage.googleapis.com/",
      "Model": "gemini-2.5-flash",
      "TimeoutSeconds": 60,
      "MaxRetries": 4
    },
    "Pipeline": {
      "BaseUrl": "http://localhost:8000",
      "TimeoutSeconds": 300,
      "CronSchedule": "0 0 1 ? * TUE,WED,THU,FRI,SAT"
    },
    "Outcomes": {
      "HorizonDays": 30,
      "BatchSize": 500,
      "CronSchedule": "0 30 2 ? * *"
    },
    "Monitor": {
      "CronSchedule": "0 15 3 ? * *",
      "IndexTicker": "^GSPC",
      "CrashWindowDays": 5,
      "CrashDropPct": 0.05
    }
  },
  "Finnhub": {
    "BaseUrl": "https://finnhub.io",
    "ApiKey": ""
  },
  "RabbitMQ": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "admin",
    "Password": ""
  },
  "OpenTelemetry": {
    "ServiceName": "Project.Api",
    "Version": "0.0.1"
  }
}