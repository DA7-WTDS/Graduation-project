# QuantWise Pipeline — environment variable template
# Copy to .env (gitignored) and fill in real values.

# ── Required ───────────────────────────────────────────────────────────────────

# Finnhub free-tier API key (https://finnhub.io).
# Used for analyst consensus, company names, and news headlines.
# Without this, sentiment falls back to yfinance only (noisier).
FINNHUB_API_KEY=

# ── Optional tuning ────────────────────────────────────────────────────────────

# Serving model (MVP_PLAN § A): "trees" = ranking_v1 champion, relative-return
# ranking with isotonic-calibrated confidence (default). "hybrid" = legacy
# LSTM→XGBoost absolute-return head with MC-dropout confidence (rollback).
# Both stacks load either way so /api/reproduce can replay any snapshot.
SERVING_MODEL=trees

# Number of parallel workers for the sentiment network I/O phase.
SENTIMENT_WORKERS=8

# yfinance hardening — raise YF_MIN_INTERVAL or set YF_PROXY on cloud if 429s appear.
YF_RETRIES=3
YF_MIN_INTERVAL=0.3
YF_PROXY=

# Path for the yfinance timezone/cookie cache (persists across restarts).
# Set by docker-compose via the yf_cache_pipeline volume — no need to set manually.
YF_CACHE_DIR=
