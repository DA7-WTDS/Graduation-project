# Backend secrets — copy to `.env` (gitignored) and fill in real values.
# Loaded by DotNetEnv at startup (Program.cs); keys use .NET "Section__Key" form.

# JWT HS256 signing key — generate with: openssl rand -base64 64
Authentication__Key=

# PostgreSQL connection (must match docker-compose)
ConnectionStrings__Database=Host=localhost;Port=5432;Database=project_db;Username=postgres;Password=postgres

# RabbitMQ password (must match docker-compose)
RabbitMQ__Password=admin

# Shared key the pipeline sends in the X-Pipeline-Key header on /api/internal/daily-results
Recommendations__Ingest__ApiKey=

# Gemini API key (recommendations LLM)
Recommendations__Llm__ApiKey=

# Finnhub API key (market data proxy)
Finnhub__ApiKey=
